<?xml version="1.0" encoding="UTF-8"?>
<!-- Used by versions-maven-plugin (see root pom pluginManagement): ignore pre-release versions
     in ./mvnw versions:display-dependency-updates versions:display-plugin-updates -->
<ruleset comparisonMethod="maven"
         xmlns="https://www.mojohaus.org/VERSIONS/RULE/2.1.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://www.mojohaus.org/VERSIONS/RULE/2.1.0 https://www.mojohaus.org/versions/versions-model/xsd/rule-2.1.0.xsd">
  <ignoreVersions>
    <ignoreVersion type="regex">(?i).*[.-](alpha|beta|rc|cr|m|milestone|preview|ea|snapshot)[.-]?\d*([.-].*)?</ignoreVersion>
  </ignoreVersions>
</ruleset>
